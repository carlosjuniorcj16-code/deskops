import platform
import time
from datetime import datetime

import psutil


def collect_diagnostics():
    """Coleta métricas e gera alertas sem alterar o sistema."""
    memory = psutil.virtual_memory()
    disk = psutil.disk_usage("/")
    cpu = psutil.cpu_percent(interval=1.0)
    temperature = read_cpu_temperature()

    uptime_hours = int(
        (time.time() - psutil.boot_time()) / 3600
    )

    alerts = []

    if cpu >= 90:
        alerts.append({
            "level": "warning",
            "message": f"Uso elevado de CPU: {cpu:.0f}%",
        })

    if memory.percent >= 90:
        alerts.append({
            "level": "warning",
            "message": (
                f"Memória quase cheia: {memory.percent:.0f}%"
            ),
        })

    if disk.percent >= 90:
        alerts.append({
            "level": "warning",
            "message": (
                f"Pouco espaço livre na raiz: "
                f"{disk.percent:.0f}% usado"
            ),
        })

    cpu_temperature = temperature.get("cpu_temperature_c")

    if cpu_temperature is not None and cpu_temperature >= 90:
        alerts.append({
            "level": "warning",
            "message": (
                f"High CPU temperature: "
                f"{cpu_temperature:.0f}°C"
            ),
        })

    if not alerts:
        alerts.append({
            "level": "ok",
            "message": (
                "Nenhum alerta automático encontrado "
                "nas verificações básicas."
            ),
        })

    return {
        "generated_at": datetime.now().astimezone().isoformat(),
        "system": {
            "os": platform.system(),
            "distribution": platform.platform(),
            "kernel": platform.release(),
            "architecture": platform.machine(),
            "python_version": platform.python_version(),
        },
        "metrics": {
            "cpu_percent": cpu,
            "memory_percent": memory.percent,
            "memory_total_bytes": memory.total,
            "memory_available_bytes": memory.available,
            "root_disk_percent": disk.percent,
            "root_disk_total_bytes": disk.total,
            "root_disk_free_bytes": disk.free,
            "uptime_hours": uptime_hours,
            **temperature,
        },
        "alerts": alerts,
    }



def read_cpu_temperature():
    """Lê sensores térmicos expostos pelo kernel Linux."""
    from pathlib import Path

    hwmon_root = Path("/sys/class/hwmon")
    readings = []

    try:
        devices = list(hwmon_root.glob("hwmon*"))
    except OSError:
        devices = []

    # Preferir o driver Intel coretemp.
    for device in devices:
        try:
            name = (device / "name").read_text().strip()
        except (OSError, ValueError):
            continue

        if name != "coretemp":
            continue

        for sensor in device.glob("temp*_input"):
            try:
                value = int(sensor.read_text().strip()) / 1000.0
            except (OSError, ValueError):
                continue

            if -10 <= value <= 130:
                readings.append(value)

    if readings:
        return {
            "cpu_temperature_c": max(readings),
            "temperature_sensor": "coretemp",
        }

    # Alternativa quando coretemp não estiver disponível.
    thermal_root = Path("/sys/class/thermal")
    try:
        zones = list(thermal_root.glob("thermal_zone*"))
    except OSError:
        zones = []

    for zone in zones:
        try:
            value = int((zone / "temp").read_text().strip()) / 1000.0
            sensor_type = (zone / "type").read_text().strip()
        except (OSError, ValueError):
            continue

        if -10 <= value <= 130:
            return {
                "cpu_temperature_c": value,
                "temperature_sensor": sensor_type,
            }

    return {
        "cpu_temperature_c": None,
        "temperature_sensor": None,
    }


def collect_metrics():
    """Coleta métricas rápidas para o monitoramento contínuo."""
    memory = psutil.virtual_memory()
    disk = psutil.disk_usage("/")
    cpu = psutil.cpu_percent(interval=None)
    temperature = read_cpu_temperature()

    return {
        "cpu_percent": cpu,
        "memory_percent": memory.percent,
        "root_disk_percent": disk.percent,
        **temperature,
    }
