    def on_diagnostics_error(self, message):
        self.diagnostics_running = False
        self.status.setText("●  SCAN FAILED")
        self.secondary_report_label.setText(
            f"Could not complete diagnostics: {message}"
        )

    def export_report(self):
        if self.last_report is None:
            QMessageBox.warning(
                self,
                "No report",
                "Run diagnostics first.",
            )
            return

        filename, _ = QFileDialog.getSaveFileName(
            self,
            "Save diagnostic report",
            str(Path.home() / "deskops-report.json"),
            "JSON files (*.json)",
        )

        if not filename:
            return

        try:
            with open(filename, "w", encoding="utf-8") as file:
                json.dump(
                    self.last_report,
                    file,
                    indent=2,
                    ensure_ascii=False,
                )

            QMessageBox.information(
                self,
                "Report saved",
                f"Diagnostic report saved to:\n{filename}",
            )

        except OSError as error:
            QMessageBox.critical(
                self,
                "Export failed",
                f"Could not save report:\n{error}",
            )

    
    def refresh_processes(self):
        # Impede que uma nova coleta comece antes da anterior terminar.
        if self.process_scan_running:
            return

        self.process_scan_running = True
        self.status.setText("●  SCANNING")

        worker = ProcessWorker()
        worker.signals.finished.connect(self.on_processes_ready)
        worker.signals.error.connect(self.on_processes_error)

        self.thread_pool.start(worker)


    def on_processes_ready(self, processes):
        self.process_scan_running = False

        self.process_table.setRowCount(len(processes))

        for row, proc in enumerate(processes):
            values = [
                str(proc["pid"]),
                proc["name"],
                f'{proc["cpu_percent"]:.1f}',
                f'{proc["memory_percent"]:.2f}',
                proc["username"],
            ]

            for column, value in enumerate(values):
                self.process_table.setItem(
                    row,
                    column,
                    QTableWidgetItem(value),
                )

        self.status.setText("●  MONITORING")


    def on_processes_error(self, message):
        self.process_scan_running = False
        self.status.setText("●  PROCESS ERROR")
        self.secondary_report_label.setText(
            f"Could not inspect processes: {message}"
        )


    def refresh_metrics(self):
        if getattr(self, "metrics_running", False):
            return

        self.metrics_running = True

        worker = MetricsWorker()
        worker.signals.finished.connect(
            self.on_metrics_ready
        )
        worker.signals.error.connect(
            self.on_metrics_error
        )

        self.thread_pool.start(worker)

    def on_metrics_ready(self, metrics):
        self.metrics_running = False

        self.cpu_value.setText(
            f'{metrics["cpu_percent"]:.0f}%'
        )
        self.mem_value.setText(
            f'{metrics["memory_percent"]:.0f}%'
        )
        self.disk_value.setText(
            f'{metrics["root_disk_percent"]:.0f}%'
        )

        self.cpu_history.append(
            float(metrics["cpu_percent"])
        )
        self.memory_history.append(
            float(metrics["memory_percent"])
        )

        samples = list(range(len(self.cpu_history)))

        self.cpu_curve.setData(
            samples, list(self.cpu_history)
        )
        self.memory_curve.setData(
            samples, list(self.memory_history)
        )

    def on_metrics_error(self, message):
        self.metrics_running = False
        self.status.setText("●  METRICS ERROR")

    def refresh_diagnostics(self):
        if self.diagnostics_running:
            return

        self.diagnostics_running = True

        worker = DiagnosticsWorker()
        worker.signals.finished.connect(
            self.on_diagnostics_ready
        )
        worker.signals.error.connect(
            self.on_diagnostics_error
        )

        self.thread_pool.start(worker)


    def on_diagnostics_ready(self, report):
        self.diagnostics_running = False
        self.last_report = report
        metrics = report["metrics"]

        self.cpu_value.setText(
            f'{metrics["cpu_percent"]:.0f}%'
        )
        self.mem_value.setText(
            f'{metrics["memory_percent"]:.0f}%'
        )
        self.disk_value.setText(
            f'{metrics["root_disk_percent"]:.0f}%'
        )

        warnings = [
            alert for alert in report["alerts"]
            if alert["level"] == "warning"
        ]

        heading = (
            f"Diagnostics complete — {len(warnings)} warning(s) found."
            if warnings else
            "Diagnostics complete — no warnings found."
        )

        details = "\n".join(
            f'• {alert["message"]}'
            for alert in report["alerts"]
        )

        timestamp = report.get("generated_at", "")
        timestamp = timestamp[:19].replace("T", " ")

        self.diagnostics_result.setText(
            f"{heading}\n"
            f"{details}\n"
            f'CPU: {metrics["cpu_percent"]:.1f}% | '
            f'RAM: {metrics["memory_percent"]:.1f}% | '
            f'Disk: {metrics["root_disk_percent"]:.1f}%\n'
            f'Uptime: {metrics["uptime_hours"]} hours | '
            f'Last check: {timestamp}'
        )

        system = report.get("system", {})
        memory_total = metrics.get("memory_total_bytes", 0)
        memory_available = metrics.get("memory_available_bytes", 0)
        disk_total = metrics.get("root_disk_total_bytes", 0)
        disk_free = metrics.get("root_disk_free_bytes", 0)

        def gib(value):
            return f"{value / (1024 ** 3):.2f} GiB"

        warning_count = len(warnings)
        status_color = "#fbbf24" if warning_count else "#86efac"
        status_text = (
            f"{warning_count} warning(s) found"
            if warning_count else "No warnings found"
        )

        cards = [
            ("CPU USAGE", f"{metrics['cpu_percent']:.1f}%",
             "Processor utilization", "#a5b4fc"),
            ("RAM USAGE", f"{metrics['memory_percent']:.1f}%",
             f"{gib(memory_available)} available", "#7dd3fc"),
            ("ROOT DISK", f"{metrics['root_disk_percent']:.1f}%",
             f"{gib(disk_free)} free", "#86efac"),
        ]

        card_html = ""
        for title, value, detail, color in cards:
            card_html += f"""
                <td style="background-color:#141b27;
                           border:1px solid #29364a;
                           padding:12px; border-radius:8px;">
                    <div style="color:#91a2bd;font-size:10px;
                                font-weight:bold;">{title}</div>
                    <div style="color:{color};font-size:22px;
                                font-weight:bold;padding:5px 0;">{value}</div>
                    <div style="color:#8d9bb1;font-size:10px;">{detail}</div>
                </td>
            """

        system_rows = [
            ("Operating system", system.get("os", "Unknown")),
            ("Distribution", system.get("distribution", "Unknown")),
            ("Kernel", system.get("kernel", "Unknown")),
            ("Architecture", system.get("architecture", "Unknown")),
            ("Python", system.get("python_version", "Unknown")),
            ("Uptime", f"{metrics.get('uptime_hours', 0)} hours"),
            ("Total RAM", gib(memory_total)),
            ("Total root filesystem", gib(disk_total)),
        ]

        rows_html = ""
        for label, value in system_rows:
            rows_html += f"""
                <tr>
                    <td style="color:#91a2bd;padding:7px;
                               border-bottom:1px solid #29364a;">{label}</td>
                    <td style="color:#e5eaf3;padding:7px;
                               border-bottom:1px solid #29364a;">{value}</td>
                </tr>
            """

        alert_html = ""
        for alert in report.get("alerts", []):
            level = alert.get("level", "info").lower()
            color = (
                "#fbbf24" if level == "warning"
                else "#86efac" if level == "ok"
                else "#93c5fd"
            )
            alert_html += f"""
                <div style="background-color:#141b27;
                            border-left:3px solid {color};
                            padding:10px;margin:6px 0;">
                    <span style="color:{color};font-weight:bold;">
                        {level.upper()}
                    </span>
                    <span style="color:#dce5f5;">
                        &nbsp; {alert.get('message', 'No details available')}
                    </span>
                </div>
            """

        html_report = f"""
        <html><body style="font-family:sans-serif;
            background-color:#0c1018;color:#dce5f5;font-size:12px;">

            <div style="color:#91aaff;font-size:10px;font-weight:bold;">
                DESKOPS / SYSTEM DIAGNOSTICS
            </div>
            <div style="font-size:22px;font-weight:bold;
                        color:#f0f4ff;padding:8px 0;">
                Scan complete
            </div>
            <div style="color:{status_color};padding-bottom:12px;">
                {status_text}
            </div>

            <table width="100%" cellspacing="5" cellpadding="0">
                <tr>{card_html}</tr>
            </table>

